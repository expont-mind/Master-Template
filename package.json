{
  "name": "monpang-master",
  "version": "0.1.0",
  "private": true,
  "description": "Master e-commerce template (Next.js + Supabase). Duplicate per client, customize via @repo/config-site + AI prompts.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .prettierignore",
    "preflight": "pnpm format:check && pnpm lint && pnpm type-check && pnpm build",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "frontend": "pnpm --filter @monpang/frontend",
    "admin": "pnpm --filter @monpang/admin",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  }
}
