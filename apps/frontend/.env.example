# =============================================================================
# Frontend environment variables
#
# Copy to `.env.local` and fill in the values. The keys are grouped by purpose
# so you can decide which sections are required for your client deployment.
#
# All `NEXT_PUBLIC_*` keys are bundled into the client JS — never put secrets
# there. Server-only keys (SUPABASE_SERVICE_ROLE_KEY, payment-provider API
# keys, Redis tokens) stay server-side.
# =============================================================================


# -----------------------------------------------------------------------------
# Brand identity (required)
# -----------------------------------------------------------------------------
# Used by packages/config-brand and packages/config-site. Without these the
# defaults fall back to "Monpang".
NEXT_PUBLIC_BRAND_NAME=Monpang
NEXT_PUBLIC_BRAND_SHORT_NAME=Monpang
NEXT_PUBLIC_SITE_URL=https://monpang.com
NEXT_PUBLIC_ADMIN_URL=https://monpang-admin.vercel.app

# Optional: override the bundled defaults for the description shown in <meta>
NEXT_PUBLIC_BRAND_DESCRIPTION=


# -----------------------------------------------------------------------------
# Contact info (Footer + Privacy + Terms pages)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=+976 7771-0900
NEXT_PUBLIC_CONTACT_EMAIL=info@monpang.com
NEXT_PUBLIC_SUPPORT_EMAIL=info@monpang.com
NEXT_PUBLIC_CONTACT_ADDRESS=


# -----------------------------------------------------------------------------
# Social links (null/empty = hide)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=monpang.mn
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=


# -----------------------------------------------------------------------------
# Delivery
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=50000


# -----------------------------------------------------------------------------
# Payment provider toggles (true/false, default true)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_QPAY=true
NEXT_PUBLIC_PAYMENT_LENDMN=true
NEXT_PUBLIC_PAYMENT_STOREPAY=true
NEXT_PUBLIC_PAYMENT_TRANSFER=true


# -----------------------------------------------------------------------------
# Feature flags (true/false, default true)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_COUPONS=true
NEXT_PUBLIC_FEATURE_ARTICLES=true
NEXT_PUBLIC_FEATURE_EVENTS=true
NEXT_PUBLIC_FEATURE_POINTS=true


# -----------------------------------------------------------------------------
# Legal (privacy-policy + terms-of-service pages)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_JURISDICTION=Mongolia
NEXT_PUBLIC_LEGAL_JURISDICTION_MN=Монгол Улс
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=info@monpang.com
NEXT_PUBLIC_COMPANY_REGISTRATION=


# -----------------------------------------------------------------------------
# SEO + analytics (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=


# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Server URL + anon key are bundled to the browser; service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Upstash Redis (server-side SWR cache, optional)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# QPay (required if NEXT_PUBLIC_PAYMENT_QPAY=true)
# -----------------------------------------------------------------------------
QUICKPAY_API_URL=
QUICKPAY_API_KEY=
QUICKPAY_MERCHANT_ID=
QUICKPAY_MCC_CODE=
QUICKPAY_BANK_CODE=
QUICKPAY_ACCOUNT_NUMBER=
QUICKPAY_ACCOUNT_NAME=
QPAY_CALLBACK_URL=
# Public versions shown in the bank-transfer UI:
NEXT_PUBLIC_QUICKPAY_ACCOUNT_NUMBER=
NEXT_PUBLIC_QUICKPAY_ACCOUNT_NAME=
NEXT_PUBLIC_QUICKPAY_BANK_NAME=


# -----------------------------------------------------------------------------
# LendMN (required if NEXT_PUBLIC_PAYMENT_LENDMN=true)
# -----------------------------------------------------------------------------
LENDMN_API_URL=
LENDMN_CLIENT_ID=
LENDMN_CLIENT_SECRET=
LENDMN_WALLET_ID=


# -----------------------------------------------------------------------------
# StorePay (required if NEXT_PUBLIC_PAYMENT_STOREPAY=true)
# -----------------------------------------------------------------------------
STOREPAY_API_URL=
STOREPAY_AUTH_URL=
STOREPAY_USERNAME=
STOREPAY_PASSWORD=
STOREPAY_APP_USERNAME=
STOREPAY_APP_PASSWORD=
STOREPAY_STORE_ID=
