# Brand identity (consumed by src/lib/utils/brand-config.ts)
NEXT_PUBLIC_BRAND_NAME=Monpang
NEXT_PUBLIC_SITE_URL=https://monpang.com
NEXT_PUBLIC_ADMIN_URL=https://monpang-admin.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (shared SWR cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMS providers — pick one and set SMS_PROVIDER accordingly.
# Valid values: "skytel" or "callpro"
SMS_PROVIDER=skytel
SKYTEL_API_URL=
SKYTEL_API_TOKEN=
CALLPRO_API_URL=
CALLPRO_API_KEY=
CALLPRO_FROM_NUMBER=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Vercel Analytics
ANALYTICS_TEAM_ID=
ANALYTICS_PROJECT_ID=
ANALYTICS_API_TOKEN=
